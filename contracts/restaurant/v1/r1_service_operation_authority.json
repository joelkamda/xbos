{
  "schema_version": 1,
  "contract": "R1_RESTAURANT_SERVICE_OPERATION_AUTHORITY",
  "accepted_head": "r1_restaurant_service_operation_042",
  "previous_head": "semantic_classification_hardening_041",
  "laws": [
    "Restaurant owns service-session/order/tab operational meaning only.",
    "SO1 owns Atomic Units/offers/prices; R1 stores commercial snapshots only.",
    "SO3 owns stock truth; R1 performs no inventory mutation.",
    "SO5 owns resource identity/capacity; R1 profiles Restaurant use only.",
    "SO10 owns reservations/scheduling; R1 references reservations optionally.",
    "PC2/PC5 own Party/identity/authorization; R1 stores staff participation only.",
    "Neutral Finance owns obligations/payments/settlement/journals/reconciliation.",
    "WND is a production specimen, not the Restaurant capability ceiling."
  ],
  "table_optional": true,
  "configurable_service_modes": true,
  "world_profiles": [
    "quick_service",
    "takeaway_delivery",
    "bar_pub",
    "casual_dining",
    "fine_dining",
    "cafeteria",
    "cloud_kitchen"
  ],
  "consumer_cart_order_foundation": {
    "public_order_read": "R1Authority.order",
    "order_read_permission": "restaurant.order.read",
    "quantity_change_command": "ChangeOrderLineQuantity",
    "quantity_change_permission": "restaurant.order.change",
    "order_truth_owner": "R1",
    "quantity_must_be_positive": true,
    "zero_quantity_is_remove": false,
    "expected_order_version_required": true,
    "expected_line_version_required": true,
    "unit_price_snapshot_repricing": false,
    "financial_truth_created": false,
    "remove_line": "RemoveOrderLine",
    "customer_safe_cancel": "NOT_ESTABLISHED"
  },
  "order_line_lifecycle": {
    "states": [
      "active",
      "removed"
    ],
    "active_cart_projection_filter": "active_only",
    "physical_delete": false,
    "preparation_existence_removal_guard": "fail_closed",
    "current_tab_partition_removal_guard": "fail_closed",
    "historical_modifier_tab_preparation_references": "preserved"
  }
}
