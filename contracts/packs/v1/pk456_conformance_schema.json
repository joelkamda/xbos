    "acceptance": [
      "required_and_selected_pack_versions_active",
      "exact_plan_sha256_matches",
      "explicit_command",
      "tenant_scoped_idempotency"
    ]
  },
  "upgrade": {
    "silent": false,
    "preserve_allowed_overrides": true,
    "removed_override_path_is_conflict": true,
    "history": "append_only"
