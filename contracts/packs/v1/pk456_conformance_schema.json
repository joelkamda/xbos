{
  "schema_version": 1,
  "certification": {
    "required_checks": {
      "architecture": "PASS",
      "tenant_isolation": "PASS",
      "migration_compatibility": "PASS",
      "authorization": "PASS",
      "semantics": "PASS",
      "finance": "PASS",
      "shared_operations": "PASS",
      "xa": "PASS",
      "manifest": "PASS"
    },
    "evidence": "one_or_more_sha256_references",
    "record": "immutable",
    "runtime_authorization": "NO"
  },
  "template_application": {
    "preflight": [
      "required_pack_versions_exist",
      "required_pack_versions_certified",
      "incompatible_packs_absent",
      "selected_optional_packs_declared",
      "overrides_allowlisted",
      "no_secret_material"
