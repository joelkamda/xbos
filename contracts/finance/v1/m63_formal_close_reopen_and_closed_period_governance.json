      "required": [
        "public_id", "tenant_id", "organization_unit_id", "reconciliation_window_public_id",
        "governed_revision_number", "accounting_period_code", "close_disposition",
        "transition_reason", "evidence_payload", "occurred_at", "business_date",
        "calendar_policy_version", "correlation_id", "source_component", "source_record_id",
        "idempotency_scope", "idempotency_key"
      ],
      "close_dispositions": ["balanced", "explained_variance", "approved_exception"]
    },
    "reopen_reconciliation_window": {
